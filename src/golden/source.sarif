{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "gantry",
          "informationUri": "https://github.com/pedronaugusto/gantry",
          "rules": [
            {"id": "os calls", "defaultConfiguration": {"level": "error"}},
            {"id": "watcher owner", "defaultConfiguration": {"level": "error"}}
          ]
        }
      },
      "columnKind": "unicodeCodePoints",
      "results": [
        {"ruleId": "watcher owner", "ruleIndex": 1, "level": "error", "message": {"text": "src/app.zig names lookout"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "src/app.zig"}, "region": {"startLine": 3, "startColumn": 30}}}]},
        {"ruleId": "os calls", "ruleIndex": 0, "level": "error", "message": {"text": "CreateFileW is spelled outside its owners"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "src/app.zig"}, "region": {"startLine": 4, "startColumn": 11}}}]}
      ]
    }
  ]
}
