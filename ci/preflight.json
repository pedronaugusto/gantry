{
  "sources": [
    "src"
  ],
  "test_roots": [
    "src/tests.zig"
  ],
  "test_support": [
    "src/testing/**"
  ],
  "test_dependencies": [
    "shakedown"
  ],
  "function_exceptions": {},
  "layout_exceptions": {},
  "docs": {
    "zig build docs -- usage": {
      "source": "examples/usage.zig",
      "region": "usage",
      "imports": [
        "gantry",
        "zig"
      ]
    },
    "zig build docs -- diagnostic": {
      "source": "examples/usage.zig",
      "region": "diagnostic",
      "imports": [
        "gantry",
        "zig"
      ]
    }
  },
  "extra_checks": [
    [
      "zig",
      "build",
      "check-consumer"
    ]
  ],
  "glint_paths": [
    "src",
    "bench",
    "ci",
    "examples",
    "build.zig"
  ],
  "glint": {
    "rules": [{"id": "P001", "level": "gate"}, {"id": "P003", "level": "gate"}, 
      {
        "id": "A004",
        "level": "gate"
      },
      {
        "id": "Z026",
        "level": "gate"
      }
    ]
  }
}
