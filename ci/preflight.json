{
  "sources": [
    "src"
  ],
  "test_roots": [
    "src/tests.zig"
  ],
  "test_support": [
    "src/testing/**"
  ],
  "test_dependencies": [
    "shakedown"
  ],
  "function_exceptions": {},
  "layout_exceptions": {},
  "docs": {
    "zig build docs -- usage": {
      "source": "examples/usage.zig",
      "region": "usage",
      "imports": [
        "gantry"
      ]
    },
    "zig build docs -- diagnostic": {
      "source": "examples/usage.zig",
      "region": "diagnostic",
      "imports": [
        "gantry"
      ]
    }
  },
  "ziglint_exceptions": "ci/ziglint-exceptions.json",
  "extra_checks": [
    [
      "zig",
      "build",
      "check-consumer"
    ]
  ],
  "unreachable_exceptions": "ci/unreachable-exceptions.json",
  "debug_print_exceptions": "ci/debug-print-exceptions.json",
  "glint_config": "ci/glint.json",
  "glint_paths": [
    "src",
    "bench",
    "ci",
    "examples",
    "build.zig"
  ]
}
