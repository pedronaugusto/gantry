{
  "sources": [
    "src"
  ],
  "test_roots": [
    "src/tests.zig"
  ],
  "test_support": [
    "src/testing/**"
  ],
  "test_dependencies": [
    "shakedown"
  ],
  "function_exceptions": {},
  "layout_exceptions": {},
  "docs": {
    "zig build docs -- usage": {
      "source": "examples/usage.zig",
      "region": "usage",
      "imports": [
        "gantry",
        "zig"
      ]
    },
    "zig build docs -- diagnostic": {
      "source": "examples/usage.zig",
      "region": "diagnostic",
      "imports": [
        "gantry",
        "zig"
      ]
    }
  },
  "extra_checks": [
    [
      "zig",
      "build",
      "check-consumer"
    ]
  ],
  "glint_paths": [
    "src",
    "bench",
    "ci",
    "examples",
    "build.zig"
  ],
  "glint": {
    "escapes": {"no-danger": 5, "internal": 4},
    "rules": [{"id": "P003", "level": "gate"}, 
      {"id": "A001", "level": "gate"},
      {"id": "A002", "level": "gate"},
      {"id": "A003", "level": "gate"},
      {
        "id": "A004",
        "level": "gate"
      },
      {"id": "A005", "level": "gate"},
      {
        "id": "Z026",
        "level": "gate"
      }
    ],
    "disallowed": [{"source": "std", "declaration": "Io.async", "reason": "the caller owns asynchronous work", "replacement": "return the work and let the caller start it"}]
  }
}
